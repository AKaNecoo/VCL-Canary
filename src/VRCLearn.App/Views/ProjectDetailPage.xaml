<UserControl
    x:Class="VRCLearn.App.Views.ProjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    xmlns:viewModels="clr-namespace:VRCLearn.App.ViewModels"
    xmlns:views="clr-namespace:VRCLearn.App.Views">

    <UserControl.Resources>
        <Style x:Key="BatchPlanButton" BasedOn="{StaticResource RowButton}" TargetType="ui:Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Installed.Count}" Value="0">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type viewModels:InstalledPackageViewModel}">
            <ui:Card Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsSelected}"
                        Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                            <Border
                                Margin="{StaticResource Gap.Inline}"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Style="{StaticResource TagChip}"
                                Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="{StaticResource FontSize.Caption}" Text="{markup:Tr ProjectDetail.CustomTag}" />
                            </Border>
                            <ui:SymbolIcon
                                Margin="{StaticResource Gap.Inline}"
                                FontSize="{StaticResource IconSize.Inline}"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Warning24"
                                ToolTip="{markup:Tr ProjectDetail.UnlockedHint}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Name}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Style="{StaticResource RowActions}">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontSize="{StaticResource FontSize.Caption}"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            MouseLeftButtonUp="OnUpgradeClick"
                            Text="{Binding NewerVersion, StringFormat={}{0} ↑}"
                            ToolTip="{markup:Tr ProjectDetail.NewerAvailable}"
                            Visibility="{Binding HasNewerVersion, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ComboBox
                            MinWidth="110"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding AvailableVersions}"
                            SelectedItem="{Binding SelectedVersion}"
                            Visibility="{Binding CanSwitchVersion, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Caption}"
                            Text="{Binding Version}"
                            Visibility="{Binding CannotSwitchVersion, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ui:Button
                            Style="{StaticResource RowButton}"
                            Appearance="Secondary"
                            Command="{markup:RowCommand ReinstallCommand}"
                            CommandParameter="{Binding}"
                            Content="{markup:Tr ProjectDetail.Reinstall}"
                            IsEnabled="{Binding CanReinstall}" />
                        <ui:Button
                            Style="{StaticResource RowButton}"
                            Appearance="Secondary"
                            Command="{markup:RowCommand RemoveCommand}"
                            CommandParameter="{Binding}"
                            Content="{markup:Tr ProjectDetail.Remove}"
                            IsEnabled="{Binding CanRemove}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AvailablePackageViewModel}">
            <ui:Card Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Name}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Style="{StaticResource RowActions}">
                        <ComboBox
                            MinWidth="110"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding AvailableVersions}"
                            SelectedItem="{Binding SelectedVersion}"
                            Visibility="{Binding CanChooseVersion, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Caption}"
                            Text="{Binding SelectedVersion}"
                            Visibility="{Binding CannotChooseVersion, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ui:Button
                            Style="{StaticResource RowButton}"
                            Appearance="Primary"
                            Command="{markup:RowCommand InstallPackageCommand}"
                            CommandParameter="{Binding}"
                            Content="{markup:Tr ProjectDetail.Add}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl
        x:Name="ProjectItems"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.ScrollUnit="Pixel">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" Style="{StaticResource PageScroll}">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemsSource>
            <CompositeCollection>
                <StackPanel x:Name="ProjectActionsSection">
                    <WrapPanel Margin="{StaticResource Gap.Field}">
                        <ui:Button
                            Margin="0,0,4,8"
                            Command="{Binding BackCommand}"
                            Icon="{ui:SymbolIcon ArrowLeft24}" />
                        <ui:ProgressRing Margin="12,0,4,8" Style="{StaticResource BusyRing}" />
                        <ui:Button
                            Margin="{StaticResource Gap.Wrapped}"
                            Style="{StaticResource ToolbarButton}"
                            Appearance="Secondary"
                            Command="{Binding RefreshCommand}"
                            Content="{markup:Tr ProjectDetail.Refresh}"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                        <ui:Button
                            Margin="{StaticResource Gap.Wrapped}"
                            Style="{StaticResource ToolbarButton}"
                            Appearance="Secondary"
                            Command="{Binding OpenFolderCommand}"
                            Content="{markup:Tr ProjectDetail.OpenFolder}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Margin="{StaticResource Gap.Wrapped}"
                            Style="{StaticResource ToolbarButton}"
                            Appearance="Secondary"
                            Command="{Binding BackupCommand}"
                            Content="{markup:Tr ProjectDetail.Backup}"
                            Icon="{ui:SymbolIcon Archive24}" />
                        <ui:Button
                            Margin="{StaticResource Gap.Wrapped}"
                            Style="{StaticResource ToolbarButton}"
                            Appearance="Secondary"
                            Command="{Binding CopyCommand}"
                            Content="{markup:Tr ProjectDetail.Copy}"
                            Icon="{ui:SymbolIcon Copy24}" />
                        <ui:Button
                            Margin="{StaticResource Gap.Wrapped}"
                            Style="{StaticResource ToolbarButton}"
                            Appearance="Secondary"
                            Command="{Binding CreateTemplateCommand}"
                            Content="{markup:Tr ProjectDetail.CreateTemplate}"
                            Icon="{ui:SymbolIcon DocumentAdd24}" />
                        <StackPanel Margin="{StaticResource Gap.Wrapped}" Orientation="Horizontal">
                            <ComboBox
                                MinWidth="150"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding InstalledEditors}"
                                SelectedItem="{Binding SelectedEditor}"
                                ToolTip="{Binding EditorCaption}"
                                Visibility="{Binding HasEditors, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <views:UnityActionButton
                                ButtonStyle="{StaticResource ToolbarButton}"
                                BringToFrontCommand="{Binding BringUnityToFrontCommand}"
                                IsUnityRunning="{Binding IsUnityRunning}"
                                LaunchCommand="{Binding OpenInUnityCommand}" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Margin="{StaticResource Gap.Small}" Orientation="Horizontal">
                        <ui:Button
                            Appearance="Secondary"
                            Command="{Binding InstallInUnityHubCommand}"
                            Content="{markup:Tr ProjectDetail.UnityInstallInHub}"
                            Visibility="{Binding HasUnityHubInstallLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <ui:InfoBar
                        Margin="{StaticResource Gap.Row}"
                        IsClosable="False"
                        IsOpen="{Binding NeedsResolve, Mode=OneWay}"
                        Message="{markup:Tr ProjectDetail.NeedsResolve}"
                        Severity="Warning">
                        <ui:Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Appearance="Primary"
                            Command="{Binding ResolveCommand}"
                            Content="{markup:Tr ProjectDetail.Resolve}" />
                    </ui:InfoBar>

                    <ui:Card
                        Margin="{StaticResource Gap.Field}"
                        Padding="{StaticResource Pad.CardRow}"
                        Visibility="{Binding HasPendingCopy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{markup:Tr ProjectDetail.Copy.Title}" />
                            <TextBlock
                                Margin="{StaticResource Gap.Tight}"
                                Style="{StaticResource Caption}"
                                Text="{markup:Tr ProjectDetail.Copy.Hint}" />

                            <DockPanel Margin="{StaticResource Gap.Row}" Style="{StaticResource BrowseRow}">
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Click="OnBrowseCopyDestinationClick"
                                    Content="{markup:Tr ProjectDetail.Browse}"
                                    Style="{StaticResource BrowseButton}" />
                                <TextBox Text="{Binding CopyDestination, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                            </DockPanel>

                            <StackPanel Margin="{StaticResource Gap.Row}" Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding ConfirmCopyCommand}"
                                    Content="{markup:Tr ProjectDetail.Copy.Confirm}" />
                                <ui:Button
                                    Margin="{StaticResource Gap.Inline}"
                                    Appearance="Secondary"
                                    Command="{Binding CancelCopyCommand}"
                                    Content="{markup:Tr ProjectDetail.Cancel}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <StackPanel Visibility="{Binding HasBackups, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ToggleButton
                            Checked="OnBackupsChecked"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            HorizontalContentAlignment="Stretch"
                            IsChecked="{Binding AreBackupsExpanded, Mode=TwoWay}"
                            Unchecked="OnBackupsUnchecked">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid Margin="{StaticResource Gap.Section}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{markup:Tr ProjectDetail.Backups.Title}" />
                                <ui:SymbolIcon
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource IconSize.Inline}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AreBackupsExpanded}" Value="True">
                                                    <Setter Property="Symbol" Value="ChevronUp24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </ToggleButton>
                        <StackPanel
                            x:Name="BackupsContent"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                            <ScrollViewer
                                MaxHeight="320"
                                Margin="{StaticResource Gap.Row}"
                                Style="{StaticResource VirtualizedListScroll}">
                                <ItemsControl
                                    ItemsSource="{Binding Backups}"
                                    ItemsPanel="{StaticResource VirtualizingStackItemsPanel}"
                                    VirtualizingPanel.ScrollUnit="Pixel"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Style="{StaticResource MissingRowCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding Display}"
                                                    ToolTip="{Binding FileName}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="{StaticResource Gap.Inline}"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionDim}"
                                                    Text="{Binding Note}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Note}"
                                                    Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Caption}"
                                                Text="{markup:Tr Backups.FileMoved}"
                                                Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ui:Button
                                                Grid.Column="1"
                                                Appearance="Secondary"
                                                Command="{markup:RowCommand RestoreCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{markup:Tr ProjectDetail.Restore}"
                                                Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Visibility="{Binding HasPendingRestore, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    Margin="{StaticResource Gap.Row}"
                                    FontSize="{StaticResource FontSize.Caption}"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Text="{Binding RestorePrompt}"
                                    TextWrapping="Wrap" />
                                <StackPanel Margin="{StaticResource Gap.Large}" Orientation="Horizontal">
                                    <ui:Button
                                        Appearance="Primary"
                                        Command="{Binding ConfirmRestoreCommand}"
                                        Content="{markup:Tr ProjectDetail.Restore.Confirm}" />
                                    <ui:Button
                                        Margin="{StaticResource Gap.Inline}"
                                        Appearance="Secondary"
                                        Command="{Binding CancelRestoreCommand}"
                                        Content="{markup:Tr ProjectDetail.Cancel}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="PendingChangesSection"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                x:Name="PendingChangesTitle"
                                Focusable="True"
                                Style="{StaticResource SectionTitle}"
                                Text="{markup:Tr ProjectDetail.Review}" />

                            <ItemsControl Margin="{StaticResource Gap.Row}" ItemsSource="{Binding PendingChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Style="{StaticResource RowCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Description}" />

                                            <ui:Button
                                                Grid.Column="1"
                                                Padding="12,3"
                                                Appearance="Secondary"
                                                Command="{markup:RowCommand RemovePendingCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{markup:Tr ProjectDetail.Remove}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Margin="{StaticResource Gap.Small}" ItemsSource="{Binding PendingConflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="{StaticResource Gap.Tight}"
                                            FontSize="{StaticResource FontSize.Caption}"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding ApplyCommand}"
                                    Content="{markup:Tr ProjectDetail.Apply}" />
                                <ui:Button
                                    Margin="{StaticResource Gap.Inline}"
                                    Appearance="Secondary"
                                    Command="{Binding DiscardCommand}"
                                    Content="{markup:Tr ProjectDetail.Discard}" />
                            </StackPanel>
                        </StackPanel>
                </StackPanel>
                <StackPanel x:Name="InstalledPackagesSection" Margin="0,0,0,8">
                    <Grid Margin="{StaticResource Gap.Section}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="{markup:Tr ProjectDetail.Installed}" />
                        <ui:Button
                            Grid.Column="1"
                            Style="{StaticResource RowButton}"
                            Appearance="Transparent"
                            Click="OnJumpToAvailableClick"
                            Content="{markup:Tr ProjectDetail.JumpToAvailable}"
                            Icon="{ui:SymbolIcon ArrowDown24}" />
                    </Grid>

                    <ui:Card Margin="0,10,0,0" Padding="16,10">
                        <WrapPanel>
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{markup:Tr ProjectDetail.Batch.Title}" />
                            <ui:Button
                                x:Name="BatchMoreButton"
                                Style="{StaticResource BatchPlanButton}"
                                Appearance="Secondary"
                                AutomationProperties.Name="{markup:Tr ProjectDetail.Batch.More}"
                                Click="OnBatchMoreClick"
                                Icon="{ui:SymbolIcon MoreHorizontal24}"
                                ToolTip="{markup:Tr ProjectDetail.Batch.More}">
                                <ui:Button.ContextMenu>
                                    <ContextMenu Placement="Bottom" Opened="OnBatchMenuOpened">
                                        <MenuItem
                                            x:Name="PrereleaseUpgradeItem"
                                            Click="OnUpgradePrereleaseClick"
                                            Header="{markup:Tr ProjectDetail.Batch.UpgradePrerelease}"
                                            Visibility="Collapsed" />
                                        <MenuItem
                                            Click="OnReinstallAllClick"
                                            Header="{markup:Tr ProjectDetail.Batch.ReinstallAll}" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <ui:Button
                                Style="{StaticResource BatchPlanButton}"
                                Appearance="Secondary"
                                Click="OnUpgradeAllClick"
                                Content="{markup:Tr ProjectDetail.Batch.UpgradeAll}" />
                            <ui:Button
                                Style="{StaticResource RowButton}"
                                Appearance="Secondary"
                                Command="{Binding ReinstallSelectedCommand}"
                                Content="{markup:Tr ProjectDetail.Batch.Reinstall}" />
                            <ui:Button
                                Style="{StaticResource RowButton}"
                                Appearance="Secondary"
                                Command="{Binding RemoveSelectedCommand}"
                                Content="{markup:Tr ProjectDetail.Batch.Remove}" />
                            <ui:Button
                                Style="{StaticResource RowButton}"
                                Appearance="Secondary"
                                Command="{Binding ClearSelectionCommand}"
                                Content="{markup:Tr ProjectDetail.Batch.Clear}" />
                        </WrapPanel>
                    </ui:Card>

                    <ui:TextBox
                        Margin="0,10,0,0"
                        x:Name="InstalledPackageSearchBox"
                        AutomationProperties.Name="{markup:Tr ProjectDetail.SearchInstalledPlaceholder}"
                        PlaceholderText="{markup:Tr ProjectDetail.SearchInstalledPlaceholder}"
                        Text="{Binding InstalledSearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <CollectionContainer x:Name="InstalledPackageRows" />
                <StackPanel x:Name="AvailablePackagesSection" Margin="0,0,0,12">
                    <Grid Margin="{StaticResource Gap.Section}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="{markup:Tr ProjectDetail.Available}" />
                        <ui:Button
                            Grid.Column="1"
                            Style="{StaticResource RowButton}"
                            Appearance="Transparent"
                            Click="OnJumpToInstalledClick"
                            Content="{markup:Tr ProjectDetail.JumpToInstalled}"
                            Icon="{ui:SymbolIcon ArrowUp24}" />
                    </Grid>

                    <ui:TextBox
                        x:Name="AvailablePackageSearchBox"
                        Margin="0,10,0,0"
                        PlaceholderText="{markup:Tr ProjectDetail.SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr ProjectDetail.SearchHint}"
                        Visibility="{Binding IsSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <CollectionContainer x:Name="AvailablePackageRows" />
                <Expander Margin="{StaticResource Gap.Large}" Header="{markup:Tr ProjectDetail.UnityArguments}">
                    <StackPanel Margin="{StaticResource Gap.Small}">
                        <TextBox
                            MinHeight="52"
                            AcceptsReturn="True"
                            Text="{Binding UnityArgumentsText, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <TextBlock
                            Margin="{StaticResource Gap.Small}"
                            Style="{StaticResource Caption}"
                            Text="{markup:Tr ProjectDetail.UnityArgumentsHint}" />
                    </StackPanel>
                </Expander>
            </CompositeCollection>
        </ItemsControl.ItemsSource>
    </ItemsControl>
</UserControl>
