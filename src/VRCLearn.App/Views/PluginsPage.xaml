<UserControl
    x:Class="VRCLearn.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <UserControl.Resources>
        <Style x:Key="PluginTab" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="TabSurface"
                            MinHeight="36"
                            Padding="12,6"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2">
                            <ContentPresenter
                                x:Name="TabTitle"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabTitle" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="TabTitle" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TabControl x:Name="PluginTabs" SelectedIndex="{Binding SelectedPluginTab, Mode=TwoWay}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel
                            Margin="32,40,32,0"
                            HorizontalAlignment="Left"
                            IsItemsHost="True"
                            KeyboardNavigation.TabIndex="0" />
                        <ContentPresenter
                            x:Name="PART_SelectedContentHost"
                            Grid.Row="1"
                            ContentSource="SelectedContent"
                            KeyboardNavigation.TabIndex="1" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="{markup:Tr Plugins.Catalog.Installed}" Style="{StaticResource PluginTab}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="32,16,32,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox
                                Grid.Column="0"
                                ClearButtonEnabled="True"
                                PlaceholderText="{markup:Tr Plugins.Search}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="130"
                                Margin="{StaticResource Gap.Inline}"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding SortOptions}"
                                SelectedValue="{Binding SelectedSort}"
                                SelectedValuePath="Value"
                                ToolTip="{markup:Tr Plugins.Sort}" />
                            <ui:Button
                                x:Name="CheckPluginUpdatesButton"
                                Grid.Column="2"
                                Margin="{StaticResource Gap.Inline}"
                                Appearance="Secondary"
                                Command="{Binding CheckUpdatesCommand}"
                                Content="{markup:Tr Plugins.CheckUpdates}"
                                IsEnabled="{Binding CanCheckUpdates}"
                                Style="{StaticResource RefreshToolbarButton}"
                                Tag="{Binding IsCheckingUpdates}" />
                            <ui:Button
                                x:Name="InstallPluginFileButton"
                                Grid.Column="3"
                                Margin="{StaticResource Gap.Inline}"
                                Appearance="Secondary"
                                Command="{Binding InstallFromFileCommand}"
                                Content="{markup:Tr Plugins.Install}" />
                        </Grid>

                    <StackPanel Grid.Row="1" Margin="32,16,32,0">
                        <TextBlock
                            Style="{StaticResource Caption}"
                            Text="{markup:Tr Plugins.Empty}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock
                            Style="{StaticResource Caption}"
                            Text="{markup:Tr Plugins.SearchEmpty}"
                            Visibility="{Binding IsSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <ItemsControl
                        Grid.Row="2"
                        Padding="32,16,32,32"
                        Style="{StaticResource VirtualizedItems}"
                        ItemsSource="{Binding FilteredPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card
                                    Style="{StaticResource RowCard}"
                                    ToolTip="{Binding ErrorText}"
                                    ToolTipService.IsEnabled="{Binding HasError}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="24"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Symbol="PuzzlePiece24"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            <Image
                                                Source="{Binding Icon}"
                                                Stretch="Uniform"
                                                Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Style="{StaticResource RowTitle}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ui:SymbolIcon
                                                    Margin="{StaticResource Gap.Inline}"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource IconSize.Inline}"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Symbol="Warning24"
                                                    ToolTip="{Binding MissingDependenciesText}"
                                                    Visibility="{Binding HasMissingDependencies, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>

                                            <StackPanel
                                                Margin="{StaticResource Gap.Tight}"
                                                Orientation="Horizontal"
                                                Visibility="{Binding HasMeta, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" />
                                                <TextBlock Style="{StaticResource Caption}" Text=" · " />
                                                <TextBlock
                                                    Style="{StaticResource Caption}"
                                                    Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Hyperlink
                                                        Command="{Binding OpenSourceCommand}"
                                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                        ToolTip="{Binding SourceUrl}">
                                                        <Run Text="{Binding SourceText, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding SourceText}"
                                                    Visibility="{Binding HasSource, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            </StackPanel>

                                            <TextBlock
                                                Margin="{StaticResource Gap.Tight}"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTip="{Binding Description}" />

                                            <TextBlock
                                                Margin="{StaticResource Gap.Tight}"
                                                Text="{Binding StatusText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTip="{Binding StatusText}"
                                                Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource Caption}" TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Style="{StaticResource RowActions}">
                                            <ui:ToggleSwitch
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                IsEnabled="{Binding CanToggle}"
                                                ToolTip="{markup:Tr Plugins.ToggleHint}" />
                                            <ui:Button
                                                Margin="{StaticResource Gap.Inline}"
                                                Padding="4"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding UpdateCommand}"
                                                IsEnabled="{Binding CanUpdate}"
                                                ToolTip="{Binding UpdateToolTip}"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ui:SymbolIcon
                                                    FontSize="{StaticResource IconSize.Inline}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Symbol="ArrowCircleUp24" />
                                            </ui:Button>
                                            <ui:Button
                                                Margin="{StaticResource Gap.Inline}"
                                                Padding="4"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding OpenDataCommand}"
                                                IsEnabled="{Binding CanOpenData}"
                                                ToolTip="{markup:Tr Plugins.OpenData}">
                                                <ui:SymbolIcon FontSize="{StaticResource IconSize.Inline}" Symbol="FolderOpen24" />
                                            </ui:Button>
                                            <ui:Button
                                                Margin="{StaticResource Gap.Inline}"
                                                Padding="4"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding UninstallCommand}"
                                                IsEnabled="{Binding CanUninstall}"
                                                ToolTip="{markup:Tr Plugins.Uninstall}">
                                                <ui:SymbolIcon
                                                    FontSize="{StaticResource IconSize.Inline}"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    Symbol="Delete24" />
                                            </ui:Button>
                                            <ui:Button
                                                Margin="{StaticResource Gap.Inline}"
                                                Appearance="Primary"
                                                Command="{Binding OpenCommand}"
                                                Content="{markup:Tr Plugins.Open}"
                                                IsEnabled="{Binding CanOpen}" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <TabItem Header="{markup:Tr Plugins.Catalog.Browse}" Style="{StaticResource PluginTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="32,16,32,0">
                        <ui:Button
                            x:Name="InstallMarketFileButton"
                            Margin="{StaticResource Gap.Inline}"
                            Appearance="Secondary"
                            Command="{Binding InstallFromFileCommand}"
                            Content="{markup:Tr Plugins.Install}"
                            DockPanel.Dock="Right" />
                        <ui:Button
                            x:Name="MarketRefreshButton"
                            MinWidth="96"
                            Margin="{StaticResource Gap.Inline}"
                            Appearance="Secondary"
                            Command="{Binding RefreshCatalogCommand}"
                            Content="{Binding CatalogRefreshText}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource RefreshToolbarButton}"
                            Tag="{Binding IsLoadingCatalog}" />
                        <ui:TextBox
                            AutomationProperties.Name="{markup:Tr Plugins.Catalog.Search}"
                            ClearButtonEnabled="True"
                            PlaceholderText="{markup:Tr Plugins.Catalog.Search}"
                            Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock
                        Grid.Row="1"
                        Margin="32,16,32,0"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource Caption}"
                        Text="{Binding CatalogNotice}"
                        Visibility="{Binding HasCatalogNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl
                        x:Name="MarketItems"
                        Grid.Row="2"
                        Padding="32,16,32,32"
                        ItemsSource="{Binding VisibleCatalog}"
                        Style="{StaticResource VirtualizedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="{StaticResource Gap.Tight}"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Meta}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Margin="{StaticResource Gap.Tight}"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Margin="{StaticResource Gap.Tight}"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Reason}"
                                                Visibility="{Binding HasReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <ui:Button
                                                MinWidth="140"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.ActOnCatalogItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding ButtonText}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Appearance" Value="Primary" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Appearance" Value="Secondary" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ProgressBar
                                                Height="4"
                                                Margin="{StaticResource Gap.Tight}"
                                                AutomationProperties.Name="{markup:Tr Plugins.Catalog.Downloading}"
                                                Value="{Binding ProgressPercent, Mode=OneWay}"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Value" Value="0">
                                                                <Setter Property="IsIndeterminate" Value="True" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
